{
  "name": "aircrypto",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted macro and crypto market dashboards (AirMacro, AirCrypto) — informational only, not investment advice.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.mjs",
    "dev:airmacro": "node --watch-path=server --watch-path=shared server/airmacro.mjs",
    "build": "vite build",
    "build:airmacro": "vite build --config apps/airmacro/vite.config.ts",
    "start": "AIRCRYPTO_PROD=1 node server/index.mjs",
    "start:airmacro": "AIRCRYPTO_PROD=1 node server/airmacro.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/airmacro/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^8.21.3",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.38",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
